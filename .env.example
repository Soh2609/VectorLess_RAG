PAGEINDEX_API_KEY=your_pageindex_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq Settings (Optional, for open-source fallback)
GROQ_API_KEY=your_groq_api_key_here
